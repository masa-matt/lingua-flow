# =======================================
# Google Generative Language (Gemini)
# =======================================
# Required: Gemini API key. Obtain from Google AI Studio.
GEMINI_API_KEY="your-gemini-api-key"
# Optional: Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# =======================================
# Notion Integration
# =======================================
# Required: Notion integration secret
NOTION_TOKEN="secret_notion_token"
# Required: Database IDs created via `make setup-notion`
ARTICLES_DB_ID="00000000-0000-0000-0000-000000000000"
PATTERNS_DB_ID="00000000-0000-0000-0000-000000000000"
OUTPUTS_DB_ID="00000000-0000-0000-0000-000000000000"
# Optional: Words DB ID (leave blank if unused)
WORDS_DB_ID=""
# Optional: Notion API version (default works for most cases)
NOTION_VERSION="2022-06-28"

# =======================================
# Text-to-Speech (shared)
# =======================================
# auto / elevenlabs / coqui / gtts
TTS_ENGINE="auto"

# --- ElevenLabs Cloud TTS ---
# Required for ElevenLabs mode: API key
ELEVEN_LABS_API_KEY=""
# Optional voice/model tuning
ELEVEN_LABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVEN_LABS_MODEL_ID="eleven_multilingual_v2"
ELEVEN_LABS_OUTPUT_FORMAT="mp3_44100_128"
# Optional: fine-tuning knobs (float values 0.0–1.0)
ELEVEN_LABS_STABILITY=""
ELEVEN_LABS_SIMILARITY=""

# --- Coqui TTS (local OSS) ---
# Default multilingual VITS model; change if you prefer another voice
COQUI_TTS_MODEL="tts_models/en/vctk/vits"
# Optional speaker/style/language overrides
COQUI_TTS_SPEAKER=""
COQUI_TTS_LANGUAGE=""
COQUI_TTS_STYLE=""
# Optional compute hints (e.g., cuda / cpu, float32 / float16 / int8)
COQUI_TTS_DEVICE=""
COQUI_TTS_COMPUTE_TYPE=""
